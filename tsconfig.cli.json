{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["cli/**/*.ts"]
}
