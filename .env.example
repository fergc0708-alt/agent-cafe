# Public URL of the site (used in skill.md, llms.txt, canonical links).
SITE_URL=http://localhost:3000

# Optional. If set, the Next.js app forwards API/MCP/agent-file requests to this origin
# (the Supabase Edge Function), e.g. https://<project-ref>.supabase.co/functions/v1/cafe
# If empty, the app runs fully in-process with an in-memory store seeded with demo data.
CAFE_API_ORIGIN=

# The Edge Function reads SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY, which Supabase injects
# automatically. Never put them in the Next.js app or in the repo.
