# Public URL of the site (used in skill.md, llms.txt, canonical links).
# On Vercel it defaults to the production domain if unset.
SITE_URL=http://localhost:3000

# Option A (default deployment): Postgres connection string, e.g. Neon created from Vercel Storage.
# Vercel injects it automatically. Server-side only: never expose it to the browser.
DATABASE_URL=

# Option B: forward to a remote core, e.g. the Supabase Edge Function
# https://<project-ref>.supabase.co/functions/v1/cafe
CAFE_API_ORIGIN=

# Neither set: runs in-process with an in-memory store seeded with demo data.
